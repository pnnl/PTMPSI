#!/usr/bin/env bash
#SBATCH --account emsl61054
#SBATCH --time 23:00:00
#SBATCH --nodes 1
#SBATCH --ntasks-per-node 1
#SBATCH --cpus-per-task 8
#SBATCH --job-name annotation_1
#SBATCH --output /tahoma/emsl61054/AMG_eco-evo_dir/renamed_sample_pfam_kofam_dir/logs/kofamscan_%A_%a.out
#SBATCH --error  /tahoma/emsl61054/AMG_eco-evo_dir/renamed_sample_pfam_kofam_dir/logs/kofamscan_%A_%a.err
#SBATCH --mail-user=ruonan.wu@pnnl.gov
#SBATCH --mail-type BEGIN,END,FAIL

set -euo pipefail

BASE_DIR="/tahoma/emsl61054/AMG_eco-evo_dir/renamed_sample_pfam_kofam_dir"
LIST_FILE="$BASE_DIR/filenames_megahit_contigs_1kb_prot"
KOFAM_EXE="/home/wuru978/kofam_scan/exec_annotation"

mkdir -p "$BASE_DIR/logs"

INPUT_LINE="$(sed -n "${SLURM_ARRAY_TASK_ID}p" "$LIST_FILE")"
[[ "$INPUT_LINE" = /* ]] && INPUT_FILE="$INPUT_LINE" || INPUT_FILE="$BASE_DIR/$INPUT_LINE"

stem="$(basename "${INPUT_FILE%.*}")"
OUT_PATH="$BASE_DIR/${stem}_kofamscan_out"
TMP_DIR="$BASE_DIR/${stem}_tmp_dir"

[[ -s "$OUT_PATH" ]] && exit 0

"$KOFAM_EXE" -o "$OUT_PATH" -f detail-tsv -E 0.001 --tmp-dir "$TMP_DIR" --cpu "$SLURM_CPUS_PER_TASK" "$INPUT_FILE"
